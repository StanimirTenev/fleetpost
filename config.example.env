# ── Copy this file to `config.env` and edit. `config.env` is git-ignored. ──
# Everything the scripts need lives here. No values are hardcoded anywhere else.

# The rclone remote that holds the shared folder. Any rclone backend works:
# Google Drive, S3, Dropbox, OneDrive, SFTP, WebDAV… Run `rclone listremotes` to see yours.
RCLONE_REMOTE="myremote:"

# Path of the coordination folder inside that remote.
COORD_DIR="agent-coordination"

# This machine's node name. Must be unique across your fleet and match its folder
# in the shared area (e.g. "laptop" -> <remote>/<COORD_DIR>/laptop/).
MACHINE_NAME="laptop"

# The other machines whose capabilities this node should pull, space-separated.
# List every node EXCEPT this one.
FLEET="desktop server"

# Local working directory (state, pulled inbox, staged descriptors). Kept off the
# shared folder on purpose.
LOCAL_ROOT="$HOME/.agent-coordination"

# OPTIONAL: directory of markdown files with a `description:` YAML front-matter field.
# If set, generate-inventory.sh builds this machine's inventory.md from those
# descriptions. Leave EMPTY to keep inventory.md a hand-written file instead.
MEMORY_DIR=""

# Minute past the hour for the scheduled run (pick something other than :00 so all
# nodes don't hit the remote at once).
TIMER_MINUTE="17"
